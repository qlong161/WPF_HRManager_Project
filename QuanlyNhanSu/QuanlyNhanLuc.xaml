<UserControl x:Class="QuanlyNhanSu.QuanlyNhanLuc"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC" FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Thanh công cụ & Bộ lọc -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnUpdateSkill" Content="Cập nhật Phân công / Kỹ năng" Width="220" Height="38" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnUpdateSkill_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Bộ lọc -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Phòng ban:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#64748B" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cbFilterDept" Width="150" Height="38" VerticalContentAlignment="Center" Margin="0,0,15,0" SelectionChanged="cbFilterDept_SelectionChanged"/>

                    <TextBox x:Name="txtSearch" Width="200" Height="38" Padding="10,0" VerticalContentAlignment="Center" TextChanged="txtSearch_TextChanged"/>
                    <TextBlock IsHitTestVisible="False" Text="🔍 Tìm Tên / Mã NV..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-190,0,0,0" Foreground="#94A3B8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="dgManPower" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="White" RowHeight="45" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                  BorderBrush="#E2E8F0" BorderThickness="1" 
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  MouseDoubleClick="dgManPower_MouseDoubleClick">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#475569"/>
                    <Setter Property="Padding" Value="10"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E0F2FE"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="MÃ NV" Binding="{Binding WN}" Width="90"/>
                <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="PHÒNG BAN" Binding="{Binding Department}" Width="150"/>

                <!-- Cột Kỹ năng Chính -->
                <DataGridTextColumn Header="VỊ TRÍ CHÍNH" Binding="{Binding MainRole}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="#0F172A"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="NL CHÍNH (%)" Binding="{Binding RoleCapacity}" Width="110"/>
                <DataGridTextColumn Header="DỰ PHÒNG 1" Binding="{Binding BackUpRole}" Width="140"/>
                <DataGridTextColumn Header="NL DP1 (%)" Binding="{Binding BackUpCapacity}" Width="100"/>
                <DataGridTextColumn Header="DỰ PHÒNG 2" Binding="{Binding BackUpRole2}" Width="140"/>
                <DataGridTextColumn Header="NL DP2 (%)" Binding="{Binding NextCapacity}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
    