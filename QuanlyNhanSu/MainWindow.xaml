<Window x:Class="QuanlyNhanSu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HR Management System"
        Height="820" Width="1350"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB"
        FontFamily="Segoe UI"
        ResizeMode="CanResize">

    <Window.Resources>

        <!-- Màu sắc -->
        <SolidColorBrush x:Key="Navy" Color="#172554"/>
        <SolidColorBrush x:Key="Blue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="Background" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="TextDark" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextGray" Color="#94A3B8"/>

        <!-- Nút Sidebar -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="12,5"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="#263B69"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="#31518B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Sidebar đang chọn -->
        <Style x:Key="ActiveSidebarButton"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3B82F6"/>
        </Style>

        <!-- Thẻ thống kê -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>

        <!-- Nút chức năng phụ -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="#172554">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="110"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="85"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="25,0">

                    <Border Width="43" Height="43"
                            Background="#3B82F6"
                            CornerRadius="12">
                        <TextBlock Text="HR"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="12,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="HR MANAGER"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Human Resources"
                                   Foreground="#94A3B8"
                                   FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Menu -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="MENU CHÍNH"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="25,10,0,12"/>

                        <Button x:Name="btnDashboard"
                                Style="{StaticResource ActiveSidebarButton}"
                                Click="btnDashboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▦" FontSize="19" Width="32"/>
                                <TextBlock Text="Tổng quan"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnEmpList"
                                Style="{StaticResource SidebarButton}"
                                Click="btnEmpList_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="♙" FontSize="20" Width="32"/>
                                <TextBlock Text="Quản lý nhân viên"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnBreaks"
                                Style="{StaticResource SidebarButton}"
                                Click="btnBreaks_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◷" FontSize="20" Width="32"/>
                                <TextBlock Text="Quản lý nghỉ phép"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnManPower"
                                Style="{StaticResource SidebarButton}"
                                Click="btnManPower_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="♧" FontSize="20" Width="32"/>
                                <TextBlock Text="Quản lý nhân lực"/>
                            </StackPanel>
                        </Button>

                        

                        <TextBlock Text="CHẤM CÔNG"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="25,30,0,12"/>

                        <Button x:Name="btnInOut"
                                Style="{StaticResource SidebarButton}"
                                Click="btnInOut_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◴" FontSize="20" Width="32"/>
                                <TextBlock Text="Vào / Ra"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnWave"
                                Style="{StaticResource SidebarButton}"
                                Click="btnWave_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▥" FontSize="20" Width="32"/>
                                <TextBlock Text="Ca làm việc"/>
                            </StackPanel>
                        </Button>

                        <!-- Thêm phần Cài đặt hệ thống ở cuối Menu -->
                        <TextBlock Text="CÀI ĐẶT"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="25,30,0,12"/>

                        <Button x:Name="btnSettings"
                                Style="{StaticResource SidebarButton}"
                                Click="btnSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="20" Width="32"/>
                                <TextBlock Text="Quản lý danh mục"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- Tài khoản -->
                <Border Grid.Row="2"
                        BorderBrush="#334155"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="20,0">

                        <Border Width="40" Height="40"
                                CornerRadius="20"
                                Background="#3B82F6">
                            <TextBlock Text="AD"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="12,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Administrator"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="12"/>
                            <TextBlock Text="Quản trị viên"
                                       Foreground="#94A3B8"
                                       FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <Grid Grid.Column="1" Background="#F4F7FB">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1">
                <Grid Margin="30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="txtPageTitle"
                                   Text="Tổng quan"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>
                        <TextBlock Text="Chào mừng bạn đến với hệ thống quản lý nhân sự"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Background="#F1F5F9"
                                CornerRadius="9"
                                Padding="13,9"
                                Margin="0,0,18,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●"
                                           Foreground="#22C55E"
                                           FontSize="10"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text=" Hệ thống hoạt động"
                                           Foreground="#64748B"
                                           FontSize="11"
                                           Margin="5,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Width="42" Height="42"
                                CornerRadius="21"
                                Background="#DBEAFE">
                            <TextBlock Text="AD"
                                       Foreground="#2563EB"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <Grid Margin="30">
                    <Grid x:Name="MainContentArea">
                        <StackPanel>

                            <!-- Welcome -->
                            <StackPanel Margin="0,0,0,25">
                                <TextBlock Text="Xin chào, Administrator 👋"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"/>
                                <TextBlock Text="Dưới đây là tình hình nhân sự tổng quan của doanh nghiệp."
                                           Foreground="#94A3B8"
                                           FontSize="13"
                                           Margin="0,7,0,0"/>
                            </StackPanel>

                            <!-- Statistics -->
                            <UniformGrid Columns="4" Margin="0,0,0,25">

                                <!-- Thẻ 1: Tổng nhân viên -->
                                <Border Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <Border Width="42" Height="42"
                    Background="#DBEAFE"
                    CornerRadius="11"
                    HorizontalAlignment="Left">
                                            <TextBlock Text="♙"
                           Foreground="#2563EB"
                           FontSize="22"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="TỔNG NHÂN VIÊN"
                       Foreground="#94A3B8"
                       FontSize="10"
                       FontWeight="Bold"
                       Margin="0,16,0,7"/>
                                        <TextBlock x:Name="txtStatTotalWorkers"
                       Text="128"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>
                                        <TextBlock Text="Nhân viên trong hệ thống"
                       FontSize="10"
                       Foreground="#94A3B8"
                       Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Thẻ 2: Đang làm việc -->
                                <Border Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <Border Width="42" Height="42"
                    Background="#DCFCE7"
                    CornerRadius="11"
                    HorizontalAlignment="Left">
                                            <TextBlock Text="✓"
                           Foreground="#16A34A"
                           FontSize="22"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="ĐANG LÀM VIỆC"
                       Foreground="#94A3B8"
                       FontSize="10"
                       FontWeight="Bold"
                       Margin="0,16,0,7"/>
                                        <TextBlock x:Name="txtStatActiveWorkers"
                       Text="112"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>
                                        <TextBlock Text="Nhân viên đang hoạt động"
                       FontSize="10"
                       Foreground="#94A3B8"
                       Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Thẻ 3: Đang nghỉ phép -->
                                <Border Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <Border Width="42" Height="42"
                    Background="#FEF3C7"
                    CornerRadius="11"
                    HorizontalAlignment="Left">
                                            <TextBlock Text="◷"
                           Foreground="#D97706"
                           FontSize="22"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="ĐANG NGHỈ PHÉP"
                       Foreground="#94A3B8"
                       FontSize="10"
                       FontWeight="Bold"
                       Margin="0,16,0,7"/>
                                        <TextBlock x:Name="txtStatOnLeave"
                       Text="08"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>
                                        <TextBlock Text="Nhân viên nghỉ hôm nay"
                       FontSize="10"
                       Foreground="#94A3B8"
                       Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Thẻ 4: Ca làm hôm nay -->
                                <Border Style="{StaticResource StatCard}"
            Margin="0">
                                    <StackPanel>
                                        <Border Width="42" Height="42"
                    Background="#F3E8FF"
                    CornerRadius="11"
                    HorizontalAlignment="Left">
                                            <TextBlock Text="▣"
                           Foreground="#9333EA"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="CA LÀM HÔM NAY"
                       Foreground="#94A3B8"
                       FontSize="10"
                       FontWeight="Bold"
                       Margin="0,16,0,7"/>
                                        <TextBlock x:Name="txtStatTodayShifts"
                       Text="06"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>
                                        <TextBlock Text="Ca làm việc được phân công"
                       FontSize="10"
                       Foreground="#94A3B8"
                       Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>

                            </UniformGrid>

                            <!-- Middle Section -->
                            <Grid Margin="0,0,0,25">
                                <!-- Quick Actions -->
                                <Border Background="White"
            CornerRadius="14"
            Padding="22">
                                    <StackPanel>
                                        <TextBlock Text="Truy cập nhanh"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>

                                        <TextBlock Text="Các chức năng thường sử dụng"
                       FontSize="11"
                       Foreground="#94A3B8"
                       Margin="0,5,0,18"/>

                                        <!-- Sử dụng UniformGrid để dàn đều 3 nút bấm trải dài ngang màn hình -->
                                        <UniformGrid Columns="3" Margin="0,5,0,0">
                                            <Button Style="{StaticResource ActionButton}"
                        Margin="0,0,10,0"
                        Height="65"
                        Click="btnEmpList_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="♙" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                    <TextBlock Text="Quản lý nhân viên" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Style="{StaticResource ActionButton}"
                        Margin="5,0,5,0"
                        Height="65"
                        Click="btnBreaks_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="◷" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                    <TextBlock Text="Quản lý nghỉ phép" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Style="{StaticResource ActionButton}"
                        Margin="10,0,0,0"
                        Height="65"
                        Click="btnInOut_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="✓" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                    <TextBlock Text="Chấm công vào / ra" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Recent Activities -->
                            <Border Background="White"
        CornerRadius="14"
        Padding="22">
                                <StackPanel>
                                    <Grid Margin="0,0,0,20">
                                        <TextBlock Text="Nhân sự mới gần đây"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>

                                        <TextBlock Text="HÔM NAY"
                       HorizontalAlignment="Right"
                       Foreground="#94A3B8"
                       FontSize="10"
                       FontWeight="Bold"/>
                                    </Grid>

                                    <!-- Danh sách động thay thế cho các item hardcode -->
                                    <ItemsControl x:Name="icRecentActivities">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8FAFC"
                            CornerRadius="9"
                            Padding="14"
                            Margin="0,0,0,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Biểu tượng icon màu sắc tùy biến theo loại hoạt động -->
                                                        <Border Width="36" Height="36"
                                    Background="{Binding BgColor}"
                                    CornerRadius="18">
                                                            <TextBlock Text="{Binding Icon}"
                                           Foreground="{Binding FgColor}"
                                           FontSize="19"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="#334155"/>
                                                            <TextBlock Text="{Binding Description}"
                                           FontSize="10"
                                           Foreground="#94A3B8"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2"
                                       Text="{Binding Time}"
                                       Foreground="#94A3B8"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </Border>

                            <TextBlock Text="HR MANAGEMENT SYSTEM  •  VERSION 1.0"
                                       HorizontalAlignment="Center"
                                       Foreground="#CBD5E1"
                                       FontSize="9"
                                       Margin="0,25,0,10"/>

                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
    