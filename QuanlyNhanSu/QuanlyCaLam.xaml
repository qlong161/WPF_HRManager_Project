<UserControl x:Class="QuanlyNhanSu.QuanlyCaLam"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC" FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Thanh công cụ & Bộ lọc -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnAddShift" Content="+ Phân ca làm việc" Width="150" Height="38" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnAddShift_Click" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="btnDeleteShift" Content="Xóa ca đã chọn" Width="120" Height="38" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnDeleteShift_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Bộ lọc theo Ngày -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Chọn ngày:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#64748B" FontWeight="SemiBold"/>
                    <DatePicker x:Name="dpFilterDate" Width="150" Height="38" VerticalContentAlignment="Center" SelectedDateChanged="dpFilterDate_SelectedDateChanged" Margin="0,0,15,0"/>

                    <TextBox x:Name="txtSearch" Width="180" Height="38" Padding="10,0" VerticalContentAlignment="Center" TextChanged="txtSearch_TextChanged"/>
                    <TextBlock IsHitTestVisible="False" Text="🔍 Tìm Mã NV / Tên..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-170,0,0,0" Foreground="#94A3B8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bảng Dữ liệu Ca làm việc -->
        <DataGrid x:Name="dgShifts" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="White" RowHeight="45" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                  BorderBrush="#E2E8F0" BorderThickness="1"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#475569"/>
                    <Setter Property="Padding" Value="10"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E0F2FE"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="MÃ NV" Binding="{Binding WN}" Width="100"/>
                <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="PHÒNG BAN" Binding="{Binding Department}" Width="180"/>
                <DataGridTextColumn Header="NGÀY LÀM" Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" Width="140"/>
                <DataGridTextColumn Header="THỜI LƯỢNG CA (GIỜ)" Binding="{Binding Shift_Duration}" Width="160"/>
                <DataGridTextColumn Header="THỜI GIAN NGHỈ (PHÚT)" Binding="{Binding Break_Duration}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
    