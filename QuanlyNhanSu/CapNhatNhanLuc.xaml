<Window x:Class="QuanlyNhanSu.CapNhatNhanLuc"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cập Nhật Phân Công &amp; Năng Lực" Height="550" Width="600"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC" ResizeMode="NoResize" FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Chi Tiết Phân Công Nhân Sự" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Cập nhật vị trí làm việc và đánh giá ma trận kỹ năng" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Form nhập liệu chia Tab -->
        <TabControl Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15">

            <!--THÔNG TIN HỒ SƠ GỐC-->
            <TabItem Header="Hồ Sơ Gốc" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="10,25,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mã nhân viên (WN):" Foreground="#64748B" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtWN" Height="35" IsReadOnly="True" Background="#F1F5F9" Padding="8,0" VerticalContentAlignment="Center" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Họ và tên:" Foreground="#64748B" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtName" Height="35" IsReadOnly="True" Background="#F1F5F9" Padding="8,0" VerticalContentAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Phòng ban / Tổ đội:" Foreground="#64748B" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtDepartment" Height="35" IsReadOnly="True" Background="#F1F5F9" Padding="8,0" VerticalContentAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!--PHÂN CÔNG -->
            <TabItem Header="Phân Công &amp; Kỹ Năng" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="10,15,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Vị trí Chính -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Vị trí làm việc chính:" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cbMainRole" Height="35" VerticalContentAlignment="Center" Background="White" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Năng lực (%):" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtMainCap" Height="35" Padding="8,0" VerticalContentAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <Separator Grid.Row="1" Margin="0,5,0,15" Background="#E2E8F0"/>

                    <!-- Vị trí Dự phòng 1 & 2 -->
                    <Grid Grid.Row="2" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Vị trí dự phòng 1:" Foreground="#475569" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cbBackUp1" Height="35" VerticalContentAlignment="Center" Margin="0,0,0,10" FontSize="14"/>
                            <TextBlock Text="Năng lực DP 1 (%):" Foreground="#475569" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtBackUpCap1" Height="35" Padding="8,0" VerticalContentAlignment="Center" FontSize="14"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Vị trí dự phòng 2:" Foreground="#475569" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cbBackUp2" Height="35" VerticalContentAlignment="Center" Margin="0,0,0,10" FontSize="14"/>
                            <TextBlock Text="Năng lực DP 2 (%):" Foreground="#475569" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtBackUpCap2" Height="35" Padding="8,0" VerticalContentAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Nút thao tác -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Lưu Phân Công" Width="140" Height="40" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnSave_Click" Margin="0,0,10,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Đóng" Width="90" Height="40" Background="#94A3B8" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnCancel_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
    