<Window x:Class="QuanlyNhanSu.PhanCaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phân Công Ca Làm Việc" Height="380" Width="400"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC" ResizeMode="NoResize" FontFamily="Segoe UI">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="PHÂN CA LÀM VIỆC" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nhân viên:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ngày làm:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Thời lượng (Giờ):" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Thời gian nghỉ (P):" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>

            <ComboBox x:Name="cbWorker" Grid.Row="0" Grid.Column="1" Height="32" VerticalContentAlignment="Center"/>
            <DatePicker x:Name="dpDate" Grid.Row="1" Grid.Column="1" Height="32" VerticalContentAlignment="Center"/>
            <TextBox x:Name="txtShiftDuration" Grid.Row="2" Grid.Column="1" Height="32" Padding="8,0" VerticalContentAlignment="Center" Text="8"/>
            <TextBox x:Name="txtBreakDuration" Grid.Row="3" Grid.Column="1" Height="32" Padding="8,0" VerticalContentAlignment="Center" Text="60"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Lưu Phân Ca" Width="110" Height="38" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnSave_Click" Margin="0,0,10,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Hủy" Width="80" Height="38" Background="#94A3B8" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnCancel_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
    