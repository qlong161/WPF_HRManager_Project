<Window x:Class="QuanlyNhanSu.ChamCongPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chấm Công" Height="420" Width="400"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC" ResizeMode="NoResize" FontFamily="Segoe UI">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Text="CHẤM CÔNG VÀO / RA" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

        <!-- Form nhập liệu -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nhân viên:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ngày làm:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Giờ (HH:mm):" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Loại:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Chú thích:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>

            <!-- Inputs -->
            <ComboBox x:Name="cbWorker" Grid.Row="0" Grid.Column="1" Height="32" VerticalContentAlignment="Center"/>
            <DatePicker x:Name="dpDate" Grid.Row="1" Grid.Column="1" Height="32" VerticalContentAlignment="Center"/>
            <TextBox x:Name="txtGio" Grid.Row="2" Grid.Column="1" Height="32" Padding="8,0" VerticalContentAlignment="Center"/>

            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="radVao" Content="Vào (In)" IsChecked="True" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,15,0"/>
                <RadioButton x:Name="radRa" Content="Ra (Out)" Foreground="#EF4444" FontWeight="Bold"/>
            </StackPanel>

            <!-- Input Chú thích -->
            <TextBox x:Name="txtChuThich" Grid.Row="4" Grid.Column="1" Height="32" Padding="8,0" VerticalContentAlignment="Center" ToolTip="Ví dụ: Quên quẹt thẻ, Đi gặp khách hàng..."/>
        </Grid>

        <!-- Nút bấm -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Lưu Chấm Công" Width="120" Height="38" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnSave_Click" Margin="0,0,10,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Hủy" Width="80" Height="38" Background="#94A3B8" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnCancel_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>