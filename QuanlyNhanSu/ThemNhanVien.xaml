<Window x:Class="QuanlyNhanSu.ThemNhanVien"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm / Sửa Nhân Viên" Height="360" Width="400"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC" ResizeMode="NoResize" FontFamily="Segoe UI">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề form -->
        <TextBlock x:Name="txtFormTitle" Text="THÊM MỚI NHÂN VIÊN" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

        <!-- Form nhập liệu hành chính -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã NV (WN):" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Họ và tên:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Phòng ban:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Ngày vào làm:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>

            <!-- Inputs -->
            <TextBox x:Name="txtWN" Grid.Row="0" Grid.Column="1" Height="32" Padding="8,0" VerticalContentAlignment="Center"/>
            <TextBox x:Name="txtName" Grid.Row="1" Grid.Column="1" Height="32" Padding="8,0" VerticalContentAlignment="Center"/>
            <ComboBox x:Name="cbDepartment" Grid.Row="2" Grid.Column="1" Height="32" VerticalContentAlignment="Center"/>
            <DatePicker x:Name="dpStartDate" Grid.Row="3" Grid.Column="1" Height="32" VerticalContentAlignment="Center"/>
        </Grid>

        <!-- Nút thao tác -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Lưu Hồ Sơ" Width="110" Height="38" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnSave_Click" Margin="0,0,10,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Hủy" Width="80" Height="38" Background="#94A3B8" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnCancel_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
    