<Window x:Class="QuanlyNhanSu.QuanlyDanhMuc"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Danh Mục Hệ Thống" Height="480" Width="500"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC" ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="QUẢN LÝ DANH MỤC" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
        <TextBlock Grid.Row="1" Text="Thêm, sửa, xóa các dữ liệu gốc của hệ thống" FontSize="12" Foreground="#64748B" Margin="0,3,0,15"/>

        <TabControl Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">

            <!-- TAB 1: PHÒNG BAN -->
            <TabItem Header="🏢 Phòng Ban (Departments)" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Khung thêm mới -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBox x:Name="txtDeptName" Width="300" Height="35" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
                        <Button x:Name="btnAddDept" Content="Thêm" Width="90" Height="35" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnAddDept_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- Danh sách -->
                    <ListBox x:Name="lstDepartments" Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,15" Padding="5" FontSize="14"/>

                    <!-- Nút xóa -->
                    <Button x:Name="btnDeleteDept" Grid.Row="2" Content="Xóa phòng ban đang chọn" Height="38" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnDeleteDept_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </TabItem>

            <!-- TAB 2: CHỨC VỤ -->
            <TabItem Header="👔 Chức Vụ (Roles)" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Khung thêm mới -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBox x:Name="txtRoleName" Width="300" Height="35" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
                        <Button x:Name="btnAddRole" Content="Thêm" Width="90" Height="35" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnAddRole_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- Danh sách -->
                    <ListBox x:Name="lstRoles" Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,15" Padding="5" FontSize="14"/>

                    <!-- Nút xóa -->
                    <Button x:Name="btnDeleteRole" Grid.Row="2" Content="Xóa chức vụ đang chọn" Height="38" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnDeleteRole_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
    