<UserControl x:Class="QuanlyNhanSu.QuanlyNghiPhep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC" FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Thanh công cụ & Bộ lọc -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnAddBreak" Content="+ Thêm Đơn Nghỉ" Width="140" Height="38" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnAddBreak_Click" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="btnDeleteBreak" Content="Xóa bản ghi" Width="110" Height="38" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnDeleteBreak_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Bộ lọc tìm kiếm -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBox x:Name="txtSearch" Width="220" Height="38" Padding="10,0" VerticalContentAlignment="Center" TextChanged="txtSearch_TextChanged"/>
                    <TextBlock IsHitTestVisible="False" Text="🔍 Tìm Mã NV / Tên / Chú thích..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-210,0,0,0" Foreground="#94A3B8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bảng Dữ liệu Nghỉ phép -->
        <DataGrid x:Name="dgBreaks" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="White" RowHeight="45" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                  BorderBrush="#E2E8F0" BorderThickness="1"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#475569"/>
                    <Setter Property="Padding" Value="10"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E0F2FE"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="MÃ NV" Binding="{Binding WN}" Width="90"/>
                <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="BẮT ĐẦU NGHỈ" Binding="{Binding BreakStart}" Width="150"/>
                <DataGridTextColumn Header="KẾT THÚC NGHỈ" Binding="{Binding BreakEnd}" Width="150"/>
                <DataGridTextColumn Header="THỜI LƯỢNG (H)" Binding="{Binding Duration}" Width="120"/>
                <DataGridTextColumn Header="ĐƯỢC PHÉP (H)" Binding="{Binding Allowed}" Width="120"/>
                <DataGridTextColumn Header="QUÁ HẠN / TRỐNG" Binding="{Binding TimeLeft}" Width="130"/>
                <DataGridTextColumn Header="LÝ DO / CHÚ THÍCH" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
    